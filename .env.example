# Copy to .env and fill in HF_TOKEN before running script/setup_runpod.sh
# or script/setup_mmlab.sh. .env is gitignored.

# Hugging Face token. Both FLUX.2 [klein] 4B repos are public, so this may
# stay empty, but a token avoids anonymous rate limits while downloading.
HF_TOKEN=

# Weight cache. On a RunPod pod, /workspace survives a restart of the container
# but not a terminated pod. On a lab machine, point HF_HOME at a local disk
# before running script/setup_mmlab.sh (that script refuses /workspace when
# the directory does not exist).
HF_HOME=/workspace/data/hf_cache
HF_HUB_ENABLE_HF_TRANSFER=1
HF_XET_HIGH_PERFORMANCE=1

# Miniconda location for script/setup_runpod.sh only. script/setup_mmlab.sh
# ignores CONDA_DIR and uses the conda already installed on the lab machine.
CONDA_DIR=/workspace/miniconda3
CONDA_ENV=flux2-klein

# Gradio. GRADIO_SHARE=1 asks Gradio for a public *.gradio.live link.
GRADIO_PORT=7860
GRADIO_SHARE=1

# Shared by the Gradio app (default seed box) and the batch CLI.
SEED=42
